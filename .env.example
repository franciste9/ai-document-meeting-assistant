# Copy to .env and fill in. Do not commit .env.

# Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for all completions (pulled from config.py, not hardcoded per call).
CLAUDE_MODEL=claude-sonnet-5

# Documents with a token_estimate above this are chunked on
# speaker-turn / paragraph boundaries; below it, passed whole.
CHUNK_TOKEN_THRESHOLD=150000

# Shared bearer token for the HTTP API's cost-incurring routes.
# Unset (the default) means auth is disabled — convenient for local dev and
# the test suite. Set it before exposing the API publicly; the gate turns on
# automatically, there's no separate flag.
ASSISTANT_API_TOKEN=
